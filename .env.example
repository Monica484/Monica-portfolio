# NVIDIA_API_KEY: Required for NVIDIA API Catalog language model generation (https://build.nvidia.com)
# Current expected model: meta/llama-3.3-70b-instruct
NVIDIA_API_KEY="nvapi-your-key-here"

# NVIDIA_MODEL: The model hosted in NVIDIA API Catalog (Default: meta/llama-3.3-70b-instruct)
# Can also be set to: nvidia/llama-3.1-nemotron-70b-instruct or mistralai/mixtral-8x7b-instruct-v0.1
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# LANGSMITH / LANGCHAIN TRACING API KEYS:
# Paste your LangSmith / LangChain API key here to automatically track and inspect all RAG traces:
LANGCHAIN_API_KEY="lsv2_pt_your-key-here"
# LANGSMITH_API_KEY="lsv2_pt_your-key-here"
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="monica-recruiter-copilot"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# GEMINI_API_KEY / GOOGLE_API_KEY: Used strictly for document embeddings
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
