{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.py": {
      "includeFiles": "data/vectorstore/**",
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,package-lock.json,bun.lock,*.pdf,server.ts}"
    }
  }
}
